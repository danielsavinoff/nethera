# =========================
# ⚙️ Backend Runtime
# =========================

# Runtime mode for the NestJS backend.
# Used by: backend AuthController to decide whether auth cookies are marked secure.
# Set to production in deployed HTTPS environments.
NODE_ENV=development

# Port the backend HTTP server listens on.
# Used by: backend/src/cmd/api/Main.ts and Docker Compose backend port/expose config.
BACKEND_PORT=3000


# =========================
# 🔐 Authentication Tokens
# =========================

# Secret used to sign and verify short-lived access JWTs.
# Used by: JwtAccessTokenService.
ACCESS_TOKEN_SECRET=CHANGE_ME_ACCESS_TOKEN_SECRET

# Access token lifetime in seconds.
# Used by: JwtAccessTokenService and auth cookie max-age.
ACCESS_TOKEN_TTL_SECONDS=600

# Secret used to sign and verify long-lived refresh JWTs.
# Used by: JwtRefreshTokenService.
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET

# Refresh token lifetime in seconds.
# Used by: JwtRefreshTokenService and refresh cookie max-age.
REFRESH_TOKEN_TTL_SECONDS=2592000


# =========================
# ✉️ Magic Link Login
# =========================

# Public backend URL that receives magic-link verification tokens.
# Used by: AuthController when generating email login links.
MAGIC_LINK_VERIFICATION_BASE_URL=http://localhost:3000/api/auth/magic/verify

# URL users are redirected to after successful magic-link verification.
# Used by: AuthController after setting auth cookies.
MAGIC_LINK_SUCCESS_REDIRECT_URL=http://localhost:5173

# Magic-link token lifetime in seconds.
# Used by: AuthController and SendMagicLinkUseCase.
MAGIC_LINK_TTL_SECONDS=900


# =========================
# 🗄️ Database
# =========================

# Database protocol for the Prisma PostgreSQL connection string.
# Used by: backend AppModule.
DATABASE_SERVER=postgresql

# Host port mapped to the Postgres container port for local Docker access.
# Used by: Docker Compose postgres port mapping.
DATABASE_EXPOSED_PORT=5432

# Port Postgres listens on inside Docker/network runtime.
# Used by: backend AppModule and Docker Compose postgres command/port mapping.
DATABASE_PORT=5432

# Postgres host name.
# Used by: backend AppModule and Docker Compose postgres container name.
DATABASE_HOST=postgres

# Postgres user.
# Used by: backend AppModule and Docker Compose postgres environment.
DATABASE_USER=myuser

# Postgres password.
# Used by: backend AppModule and Docker Compose postgres environment.
DATABASE_PASS=CHANGE_ME_DATABASE_PASSWORD

# Postgres database name.
# Used by: backend AppModule and Docker Compose postgres environment.
DATABASE=mydb


# =========================
# 🌐 Localization
# =========================

# Default locale used when a request does not provide a specific locale.
# Used by: backend i18n module and subscription/billing controllers.
FALLBACK_LANGUAGE=en


# =========================
# 📧 Email Notifications
# =========================

# SMTP server host for transactional emails.
# Used by: backend NotificationModule.
SMTP_HOST=CHANGE_ME_SMTP_HOST

# SMTP server port.
# Used by: backend NotificationModule.
SMTP_PORT=465

# SMTP username.
# Used by: backend NotificationModule.
SMTP_USER=CHANGE_ME_SMTP_USER

# SMTP password.
# Used by: backend NotificationModule.
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Email address used in the From header.
# Used by: backend NotificationModule.
SMTP_SENDER=noreply@example.com


# =========================
# 💳 NOWPayments
# =========================

# NOWPayments API base URL.
# Used by: NowPaymentsInvoiceProvider.
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# NOWPayments API key for invoice creation.
# Used by: NowPaymentsInvoiceProvider.
NOWPAYMENTS_API_KEY=CHANGE_ME_NOWPAYMENTS_API_KEY

# Secret used to verify NOWPayments IPN webhook signatures.
# Used by: NowPaymentsGuard.
NOWPAYMENTS_IPN_SECRET=CHANGE_ME_NOWPAYMENTS_IPN_SECRET

# Public webhook URL NOWPayments calls when payment status changes.
# Used by: NowPaymentsInvoiceProvider as ipn_callback_url.
IPN_CALLBACK_URL=https://example.com/api/billing/nowpayments/webhook

# URL NOWPayments sends users to after checkout success.
# Used by: NowPaymentsInvoiceProvider as success_url.
PAYMENT_SUCCESS_REDIRECT_URL=http://localhost:5173


# =========================
# 🛡️ Remnawave VPN Provider
# =========================

# Remnawave API base URL.
# Used by: RemnawaveBaseProvider.
REMNAWAVE_BASE_URL=https://remnawave.example.com

# Bearer token used for Remnawave API requests.
# Used by: RemnawaveBaseProvider.
REMNAWAVE_API_TOKEN=CHANGE_ME_REMNAWAVE_API_TOKEN

# Optional query string token appended to Remnawave URLs, without a leading question mark.
# Used by: RemnawaveBaseProvider.
REMNAWAVE_QUERY_TOKEN=CHANGE_ME_REMNAWAVE_QUERY_TOKEN

# Internal Remnawave squad ID assigned to newly created VPN users.
# Used by: RemnawaveVpnSubscriptionProvider.
REMNAWAVE_NEW_USER_INTERNAL_SQUAD_ID=CHANGE_ME_REMNAWAVE_SQUAD_ID


# =========================
# 🖥️ Frontend Service
# =========================

# Frontend container/service host name.
# Used by: Docker Compose frontend container name and production frontend HOST.
FRONTEND_HOST=frontend

# Port the frontend dev server or production server listens on.
# Used by: Docker Compose frontend port/expose config and frontend/vite.config.ts.
FRONTEND_PORT=5173

# Backend URL used by the Vite dev server proxy for /api requests.
# Used by: frontend/vite.config.ts.
BACKEND_URL=http://backend:3000

# Browser-facing API base URL used by the generated frontend API client.
# Used by: frontend/src/api/api.ts.
VITE_API_URL=http://localhost:5173/api


# =========================
# 📘 OpenAPI Client Generation
# =========================

# Backend OpenAPI YAML endpoint used to generate frontend API types/client.
# Used by: frontend/orval.config.ts when running npm run generate:api.
OPENAPI_URL=http://localhost:3000/api/openapi-yaml


# =========================
# 🚦 Reverse Proxy
# =========================

# Public domain served by the frontend Caddy runtime or external ingress.
# Used by: deployed environments when configuring public routing.
DOMAIN=localhost
