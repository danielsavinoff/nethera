generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @db.Uuid

  email        String
  is_deleted   Boolean @default(false)
  locale                  String? @db.VarChar(10)
  preferred_currency_code String? @db.Char(3)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  session         Session[]
  userRoles       UserRoleAssignment[]
  subscriptions   Subscription[]
  vpnSubscription VpnSubscription?
  payments        Payment[]
  invoices        Invoice[]

  @@unique([email], where: { is_deleted: false })
  @@map("users")
}

model AuthToken {
  id String @id @default(uuid()) @db.Uuid

  email                String
  token_hash           String  @unique
  requested_ip         String? @db.Inet
  requested_user_agent String?

  expires_at DateTime
  created_at DateTime  @default(now())
  used_at    DateTime?

  @@map("auth_tokens")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  refresh_token String @unique

  expires_at DateTime
  created_at DateTime @default(now())

  user_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  permissions PermissionOnRole[]
  userRoles   UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  roles PermissionOnRole[]

  @@map("permissions")
}

model PermissionOnRole {
  created_at DateTime @default(now())

  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRoleAssignment {
  created_at DateTime @default(now())

  user_id String @db.Uuid
  role_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@map("user_roles")
}

model SubscriptionPlan {
  id String @id @default(uuid()) @db.Uuid

  is_public              Boolean @default(true)
  billing_interval       String  @db.VarChar(16)
  billing_interval_count Int     @default(1)
  code                   String  @unique @db.VarChar(64)
  trial_days             Int?

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  subscriptions Subscription[]
  translations  SubscriptionPlanTranslation[]
  features      SubscriptionPlanFeature[]
  prices        SubscriptionPlanPrice[]

  @@index([is_public])
  @@map("subscription_plans")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  status     String  @db.VarChar(32)
  auto_renew Boolean @default(false)

  started_at       DateTime? @db.Timestamptz
  expires_at       DateTime? @db.Timestamptz
  trial_started_at DateTime? @db.Timestamptz
  trial_ends_at    DateTime? @db.Timestamptz
  canceled_at      DateTime? @db.Timestamptz
  ended_at         DateTime? @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz

  user_id              String @db.Uuid
  subscription_plan_id String @db.Uuid

  user             User             @relation(fields: [user_id], references: [id])
  subscriptionPlan SubscriptionPlan @relation(fields: [subscription_plan_id], references: [id])

  @@index([user_id])
  @@index([subscription_plan_id])
  @@index([status])
  @@index([expires_at])
  @@map("subscriptions")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  status          String  @db.VarChar(32)
  amount_minor    Int
  currency        String  @db.Char(3)
  provider        String  @db.VarChar(32)
  external_id     String  @db.VarChar(255)
  failure_code    String? @db.VarChar(64)
  failure_message String?
  metadata        Json?

  due_at     DateTime? @db.Timestamptz
  paid_at    DateTime? @db.Timestamptz
  failed_at  DateTime? @db.Timestamptz
  voided_at  DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz

  user_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id])

  @@unique([provider, external_id])
  @@index([user_id])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  external_id           String @db.VarChar(255)
  provider              String @db.VarChar(32)
  billing_email         String @db.VarChar(255)
  status                String @db.VarChar(32)
  total_amount_minor    Int
  amount_paid_minor     Int
  currency              String
  external_checkout_url String

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  expires_at DateTime? @db.Timestamptz

  user_id String @db.Uuid

  user  User          @relation(fields: [user_id], references: [id])
  lines InvoiceLine[]

  @@unique([provider, external_id])
  @@index([user_id])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id String @id @default(uuid()) @db.Uuid

  reference_id String @db.VarChar(255)
  type         String @db.VarChar(64)
  title        String?
  amount       Int

  invoice_id String @db.Uuid

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([reference_id, type])
  @@index([invoice_id])
  @@map("invoice_lines")
}

model SubscriptionPlanPrice {
  id String @id @default(uuid()) @db.Uuid

  amount_minor Int
  currency     String  @db.Char(3)
  locale       String  @db.VarChar(10)
  is_active    Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz

  subscription_plan_id String @db.Uuid

  subscriptionPlan SubscriptionPlan @relation(fields: [subscription_plan_id], references: [id], onDelete: Cascade)

  @@unique([subscription_plan_id, locale], where: { is_active: true })
  @@index([subscription_plan_id])
  @@index([locale])
  @@map("subscription_plan_prices")
}

model VpnSubscription {
  id String @id @default(uuid()) @db.Uuid

  provider         String @db.VarChar(32)
  external_id      String @db.VarChar(255)
  subscription_url String

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  user_id String @unique @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, external_id])
  @@map("vpn_subscriptions")
}

model SubscriptionPlanTranslation {
  id String @id @default(uuid()) @db.Uuid

  locale      String  @db.VarChar(10)
  name        String  @db.VarChar(255)
  description String?

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  subscription_plan_id String @db.Uuid

  subscriptionPlan SubscriptionPlan @relation(fields: [subscription_plan_id], references: [id], onDelete: Cascade)

  @@unique([subscription_plan_id, locale])
  @@index([locale])
  @@map("subscription_plan_translations")
}

model SubscriptionPlanFeature {
  id String @id @default(uuid()) @db.Uuid

  code       String  @db.VarChar(64)
  sort_order Int     @default(0)
  is_active  Boolean @default(true)
  value      String? @db.VarChar(255)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  subscription_plan_id String @db.Uuid

  subscriptionPlan SubscriptionPlan                     @relation(fields: [subscription_plan_id], references: [id], onDelete: Cascade)
  translations     SubscriptionPlanFeatureTranslation[]

  @@unique([subscription_plan_id, code])
  @@index([subscription_plan_id])
  @@index([sort_order])
  @@map("subscription_plan_features")
}

model SubscriptionPlanFeatureTranslation {
  id String @id @default(uuid()) @db.Uuid

  locale      String  @db.VarChar(10)
  title       String  @db.VarChar(255)
  description String?

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  subscription_plan_feature_id String @db.Uuid

  subscriptionPlanFeature SubscriptionPlanFeature @relation(fields: [subscription_plan_feature_id], references: [id], onDelete: Cascade)

  @@unique([subscription_plan_feature_id, locale])
  @@index([locale])
  @@map("subscription_plan_feature_translations")
}
