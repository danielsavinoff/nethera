# =========================
# 🖥️ Frontend Service Configuration
# =========================

# Port for the frontend service.
FRONTEND_PORT=5173

# =========================



# =========================
# 📘 OpenAPI Configuration
# =========================

# This is used by the frontend to generate API clients and documentation.
OPENAPI_URL=http://localhost:3000/openapi-yaml

# =========================



# =========================
# 🔌 Backend API
# =========================

# Used for a reverse proxy in development mode.
BACKEND_URL=http://backend:3000

# The base URL a frontend uses when making requests to the backend.
VITE_API_URL=http://localhost:5173/api

# =========================